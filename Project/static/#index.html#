<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Factory Twin Pro | Industrial Dashboard</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-dark: #121212;
            --bg-card: #1e1e1e;
            --bg-card-hover: #252525;
            --text-main: #e0e0e0;
            --text-muted: #a0a0a0;
            --accent-primary: #00bcd4; /* Cyan */
            --accent-success: #00e676; /* Green */
            --accent-warning: #ff9100; /* Orange */
            --accent-danger: #ff1744; /* Red */
            --border-color: #333;
            --shadow: 0 4px 20px rgba(0,0,0,0.4);
            --radius: 12px;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-main);
            padding: 20px;
            min-height: 100vh;
        }

        /* --- Header --- */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 1px solid var(--border-color);
        }
        .header h1 {
            font-size: 24px;
            font-weight: 700;
            background: linear-gradient(90deg, #fff, var(--accent-primary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .header-status {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 14px;
            color: var(--accent-success);
            background: rgba(0, 230, 118, 0.1);
            padding: 6px 12px;
            border-radius: 20px;
        }
        .pulse-dot {
            width: 8px;
            height: 8px;
            background-color: var(--accent-success);
            border-radius: 50%;
            animation: pulse 1.5s infinite;
        }

        /* --- Grid Layout --- */
        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            gap: 20px;
            margin-bottom: 20px;
        }

        /* --- Cards --- */
        .card {
            background: var(--bg-card);
            border-radius: var(--radius);
            padding: 20px;
            box-shadow: var(--shadow);
            border: 1px solid var(--border-color);
            transition: transform 0.2s, background 0.2s;
            position: relative;
            overflow: hidden;
        }
        .card:hover {
            transform: translateY(-2px);
            background: var(--bg-card-hover);
            border-color: var(--accent-primary);
        }
        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }
        .card-title {
            font-size: 16px;
            font-weight: 600;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .card-title i { color: var(--accent-primary); }

        /* --- KPI Blocks --- */
        .kpi-row {
            grid-column: span 12;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 20px;
        }
        .kpi-card {
            background: var(--bg-card);
            padding: 20px;
            border-radius: var(--radius);
            border-left: 4px solid var(--accent-primary);
            box-shadow: var(--shadow);
        }
        .kpi-label { font-size: 12px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; }
        .kpi-value { font-size: 28px; font-weight: 700; margin: 5px 0; }
        .kpi-trend { font-size: 13px; font-weight: 500; display: flex; align-items: center; gap: 4px; }
        .trend-up { color: var(--accent-danger); }
        .trend-down { color: var(--accent-success); }

        /* --- Flow Scheme --- */
        .flow-section { grid-column: span 12; }
        .flow-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 15px;
            padding: 20px 0;
        }
        .flow-node {
            flex: 1;
            min-width: 100px;
            padding: 15px 10px;
            text-align: center;
            background: #2c2c2c;
            border-radius: 8px;
            font-weight: 600;
            font-size: 14px;
            position: relative;
            transition: all 0.3s;
            border: 1px solid #444;
        }
        .flow-arrow { color: var(--text-muted); font-size: 18px; }
        
        /* Status Colors for Nodes */
        .node-normal { border-color: var(--accent-success); color: var(--accent-success); box-shadow: 0 0 10px rgba(0,230,118,0.1); }
        .node-warning { border-color: var(--accent-warning); color: var(--accent-warning); box-shadow: 0 0 10px rgba(255,145,0,0.2); }
        .node-critical { 
            border-color: var(--accent-danger); 
            color: var(--accent-danger); 
            background: rgba(255, 23, 68, 0.1);
            animation: pulse-border 1s infinite;
        }

        /* --- Incidents --- */
        .incidents-section { grid-column: span 12; }
        .incident-list { display: flex; flex-direction: column; gap: 10px; max-height: 300px; overflow-y: auto; }
        .incident-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px;
            background: #252525;
            border-radius: 6px;
            border-left: 3px solid gray;
        }
        .incident-critical { border-left-color: var(--accent-danger); background: rgba(255, 23, 68, 0.05); }
        .incident-warning { border-left-color: var(--accent-warning); background: rgba(255, 145, 0, 0.05); }
        .incident-title { font-weight: 600; font-size: 14px; }
        .incident-meta { font-size: 12px; color: var(--text-muted); }

        /* --- Charts & Tables --- */
        .chart-section-lg { grid-column: span 8; }
        .chart-section-sm { grid-column: span 4; }
        
        @media (max-width: 992px) {
            .chart-section-lg, .chart-section-sm { grid-column: span 12; }
        }

        canvas { width: 100% !important; height: 250px !important; }

        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        th { text-align: left; color: var(--text-muted); padding: 10px; border-bottom: 1px solid #333; font-weight: 500; }
        td { padding: 10px; border-bottom: 1px solid #2a2a2a; color: var(--text-main); }
        tr:last-child td { border-bottom: none; }
        
        .status-badge {
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
        }
        .badge-crit { background: rgba(255, 23, 68, 0.2); color: var(--accent-danger); }
        .badge-warn { background: rgba(255, 145, 0, 0.2); color: var(--accent-warning); }
        .badge-norm { background: rgba(0, 230, 118, 0.2); color: var(--accent-success); }

        /* --- Animations --- */
        @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.4; } 100% { opacity: 1; } }
        @keyframes pulse-border { 0% { box-shadow: 0 0 0 0 rgba(255, 23, 68, 0.4); } 70% { box-shadow: 0 0 0 10px rgba(255, 23, 68, 0); } 100% { box-shadow: 0 0 0 0 rgba(255, 23, 68, 0); } }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #1a1a1a; }
        ::-webkit-scrollbar-thumb { background: #444; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #555; }
    </style>
</head>
<body>

<div class="header">
    <h1><i class="fas fa-industry"></i> Factory Twin Pro</h1>
    <div class="header-status">
        <div class="pulse-dot"></div>
        LIVE MONITORING
    </div>
</div>

<!-- KPI ROW -->
<div class="kpi-row">
    <div class="kpi-card" style="border-left-color: var(--accent-primary);">
        <div class="kpi-label">Здоровье завода</div>
        <div id="health-score" class="kpi-value">100%</div>
        <div class="kpi-trend" style="color: var(--accent-success);">Оптимально</div>
    </div>
    <div class="kpi-card" style="border-left-color: var(--accent-warning);">
        <div class="kpi-label">Уровень брака</div>
        <div id="defect-rate" class="kpi-value">0%</div>
        <div id="defect-trend" class="kpi-trend">-</div>
    </div>
    <div class="kpi-card" style="border-left-color: var(--accent-success);">
        <div class="kpi-label">Выполнение плана</div>
        <div id="plan-progress" class="kpi-value">0%</div>
        <div class="kpi-trend" style="color: var(--text-muted);">Цель: 5500 ед.</div>
    </div>
    <div class="kpi-card" style="border-left-color: var(--accent-danger);">
        <div class="kpi-label">Активные инциденты</div>
        <div id="active-incidents" class="kpi-value">0</div>
        <div class="kpi-trend" style="color: var(--text-muted);">Требует внимания</div>
    </div>
</div>

<!-- AI INSIGHTS BLOCK -->
<div class="card" style="grid-column: span 12; border-left: 4px solid var(--accent-primary);">
    <div class="card-header">
        <div class="card-title"><i class="fas fa-brain"></i> AI Аналитика и Рекомендации</div>
    </div>
    <div id="ai-insights-list" style="display: flex; flex-direction: column; gap: 10px;">
        <div style="text-align:center; color:var(--text-muted); padding:10px;">Анализ данных в процессе...</div>
    </div>
</div>

<!-- SCHEME -->
<div class="card flow-section">
    <div class="card-header">
        <div class="card-title"><i class="fas fa-project-diagram"></i> Производственный поток</div>
    </div>
    <div class="flow-container">
        <div class="flow-node node-stock">Склад</div>
        <div class="flow-arrow"><i class="fas fa-chevron-right"></i></div>
        <div id="node-svar" class="flow-node node-weld">Сварка</div>
        <div class="flow-arrow"><i class="fas fa-chevron-right"></i></div>
        <div id="node-okr" class="flow-node node-paint">Окраска</div>
        <div class="flow-arrow"><i class="fas fa-chevron-right"></i></div>
        <div id="node-sbor" class="flow-node node-assem">Сборка</div>
        <div class="flow-arrow"><i class="fas fa-chevron-right"></i></div>
        <div class="flow-node node-qa">Контроль</div>
        <div class="flow-arrow"><i class="fas fa-chevron-right"></i></div>
        <div class="flow-node node-stock">Продукция</div>
    </div>
</div>

<!-- INCIDENTS -->
<div class="card incidents-section">
    <div class="card-header">
        <div class="card-title"><i class="fas fa-exclamation-triangle"></i> Центр инцидентов</div>
        <div style="display:flex; gap:5px;">
            <button onclick="filterIncidents('all')" class="filter-btn active">Все</button>
            <button onclick="filterIncidents('critical')" class="filter-btn">Крит.</button>
            <button onclick="filterIncidents('warning')" class="filter-btn">Пред.</button>
        </div>
    </div>
    <div id="incidents-list" class="incident-list">
        <div style="text-align:center; color:var(--text-muted); padding:20px;">Нет активных инцидентов</div>
    </div>
</div>

<!-- CHARTS & TABLES -->
<div class="dashboard-grid">
    <div class="card chart-section-lg">
        <div class="card-header">
            <div class="card-title"><i class="fas fa-chart-bar"></i> Выполнение плана (Модели)</div>
        </div>
        <canvas id="planChart"></canvas>
    </div>

    <div class="card chart-section-sm">
        <div class="card-header">
            <div class="card-title"><i class="fas fa-thermometer-half"></i> Температура (Live)</div>
        </div>
        <canvas id="tempChart"></canvas>
    </div>

    <div class="card chart-section-sm">
        <div class="card-header">
            <div class="card-title"><i class="fas fa-stopwatch"></i> Последние простои</div>
        </div>
        <table id="downtime-table">
            <thead><tr><th>Линия</th><th>Причина</th><th>Мин</th></tr></thead>
            <tbody></tbody>
        </table>
    </div>

    <div class="card chart-section-lg">
        <div class="card-header">
            <div class="card-title"><i class="fas fa-boxes"></i> Критичные поставки</div>
        </div>
        <table id="supply-table">
            <thead><tr><th>Деталь</th><th>Остаток</th><th>Статус</th></tr></thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<script>
    let currentFilter = 'all';
    let allIncidents = [];

    // Chart Config
    Chart.defaults.color = '#a0a0a0';
    Chart.defaults.borderColor = '#333';
    
    const ctxPlan = document.getElementById('planChart').getContext('2d');
    const planChart = new Chart(ctxPlan, {
        type: 'bar',
        data: { labels: [], datasets: [
            { label: 'Выполнено', data: [], backgroundColor: '#00bcd4', borderRadius: 4 },
            { label: 'Осталось', data: [], backgroundColor: '#333', borderRadius: 4 }
        ]},
        options: { 
            responsive: true, 
            maintainAspectRatio: false,
            plugins: { legend: { position: 'top' } },
            scales: { x: { stacked: true }, y: { stacked: true, grid: { color: '#333' } } }
        }
    });

    const ctxTemp = document.getElementById('tempChart').getContext('2d');
    const tempChart = new Chart(ctxTemp, {
        type: 'line',
        data: { labels: [], datasets: [
            { label: 'Сварка', data: [], borderColor: '#00bcd4', tension: 0.4, borderWidth: 2 },
            { label: 'Окраска', data: [], borderColor: '#ff9100', tension: 0.4, borderWidth: 2 },
            { label: 'Сборка', data: [], borderColor: '#00e676', tension: 0.4, borderWidth: 2 }
        ]},
        options: { 
            responsive: true, 
            maintainAspectRatio: false,
            animation: false,
            plugins: { legend: { position: 'bottom' } },
            scales: { y: { grid: { color: '#333' } } }
        }
    });

    function filterIncidents(type) {
        currentFilter = type;
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        event.target.classList.add('active');
        renderIncidents();
    }

    function renderIncidents() {
        const container = document.getElementById('incidents-list');
        const filtered = allIncidents.filter(i => currentFilter === 'all' || i.sev === currentFilter);
        
        if (filtered.length === 0) {
            container.innerHTML = '<div style="text-align:center; color:var(--text-muted); padding:20px;">Нет инцидентов выбранного типа</div>';
            return;
        }

        container.innerHTML = filtered.map(i => `
            <div class="incident-item incident-${i.sev}">
                <div>
                    <div class="incident-title">${i.title}</div>
                    <div class="incident-meta">${i.loc}</div>
                </div>
                <span class="status-badge ${i.sev === 'critical' ? 'badge-crit' : 'badge-warn'}">${i.sev}</span>
            </div>
        `).join('');
    }

    async function fetchData() {
        try {
            const res = await fetch('/api/data');
            const data = await res.json();
            
            // 1. Scheme
            const mapId = { "Сварка": "node-svar", "Окраска": "node-okr", "Сборка": "node-sbor" };
            for (const [line, status] of Object.entries(data.schema || {})) {
                const el = document.getElementById(mapId[line]);
                if (el) {
                    el.className = 'flow-node'; // Reset
                    if (status === 'critical') el.classList.add('node-critical');
                    else if (status === 'warning') el.classList.add('node-warning');
                    else el.classList.add('node-normal');
                }
            }

            // 2. Incidents
            allIncidents = [];
            if (data.defect_rate > 2) allIncidents.push({sev: data.defect_rate > 5 ? 'critical' : 'warning', title: `Брак ${data.defect_rate.toFixed(2)}%`, loc: 'Качество'});
            for (const [line, status] of Object.entries(data.statuses)) {
                if (status !== 'normal') allIncidents.push({sev: status, title: `${line}: ${status.toUpperCase()}`, loc: line});
            }
            data.supplies.forEach(s => allIncidents.push({sev: s.status, title: `Дефицит: ${s.part_name}`, loc: 'Склад'}));
            
            document.getElementById('active-incidents').innerText = allIncidents.length;
            renderIncidents();

            // 3. KPI
            const rateEl = document.getElementById('defect-rate');
            rateEl.innerText = data.defect_rate.toFixed(2) + '%';
            rateEl.style.color = data.defect_rate > 2 ? 'var(--accent-danger)' : 'var(--accent-success)';
            
            const trendEl = document.getElementById('defect-trend');
            if (data.trend_defect > 0) {
                trendEl.innerHTML = `<i class="fas fa-arrow-up"></i> ${(data.trend_defect).toFixed(2)}%`;
                trendEl.className = 'kpi-trend trend-up';
            } else if (data.trend_defect < 0) {
                trendEl.innerHTML = `<i class="fas fa-arrow-down"></i> ${Math.abs(data.trend_defect).toFixed(2)}%`;
                trendEl.className = 'kpi-trend trend-down';
            } else {
                trendEl.innerHTML = '-';
                trendEl.className = 'kpi-trend';
            }

            if (data.progress !== undefined) document.getElementById('plan-progress').innerText = data.progress.toFixed(1) + '%';

            // 4. Health Score
            const scoreEl = document.getElementById('health-score');
            scoreEl.innerText = data.health_score + '%';
            scoreEl.style.color = data.health_score > 80 ? 'var(--accent-success)' : (data.health_score > 50 ? 'var(--accent-warning)' : 'var(--accent-danger)');

            // 5. Tables
            const dtBody = document.querySelector('#downtime-table tbody');
            dtBody.innerHTML = data.downtimes.map(d => `<tr><td>${d.line}</td><td>${d.reason}</td><td>${d.duration}</td></tr>`).join('') || '<tr><td colspan="3" style="text-align:center">Нет данных</td></tr>';

            const supBody = document.querySelector('#supply-table tbody');
            supBody.innerHTML = data.supplies.map(s => `
                <tr>
                    <td>${s.part_name}</td>
                    <td>${s.stock}</td>
                    <td><span class="status-badge ${s.status==='critical'?'badge-crit':'badge-warn'}">${s.status}</span></td>
                </tr>
            `).join('') || '<tr><td colspan="3" style="text-align:center">Нет критичных</td></tr>';

            // 6. Charts
            if (data.plans && data.plans.length > 0) {
                planChart.data.labels = data.plans.map(p => p.model);
                planChart.data.datasets[0].data = data.plans.map(p => p.produced);
                planChart.data.datasets[1].data = data.plans.map(p => Math.max(0, p.remaining));
                planChart.update();
            }
            if (data.chart && data.chart.length > 0) {
                tempChart.data.labels = data.chart.map(c => c.time);
                tempChart.data.datasets[0].data = data.chart.map(c => c.svar || 0);
                tempChart.data.datasets[1].data = data.chart.map(c => c.okr || 0);
                tempChart.data.datasets[2].data = data.chart.map(c => c.sbor || 0);
                tempChart.update();
            }

        } catch (err) { console.error("Error:", err); }
	}
		

    fetchData();
    setInterval(fetchData, 3000);
</script>
</body>
</html>
